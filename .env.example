# Copy this file to .env at the repository root (gitignored) and fill in real values.
# Generate a strong secret, e.g.:
#   python -c "import secrets; print(secrets.token_hex(32))"

# --- Runtime environment -----------------------------------------------------
APP_ENV=development

# --- JWT / access tokens -----------------------------------------------------
JWT_SECRET_KEY=replace-with-a-long-random-secret
ACCESS_TOKEN_EXPIRES_MINUTES=30
JWT_ALGORITHM=HS256

# --- Refresh tokens & auth cookie --------------------------------------------
REFRESH_TOKEN_EXPIRES_DAYS=7
REFRESH_COOKIE_NAME=brasaland_refresh
COOKIE_SECURE=false

# --- Email verification ------------------------------------------------------
EMAIL_VERIFICATION_EXPIRES_HOURS=24
FRONTEND_BASE_URL=http://localhost:3000

# --- Password reset ----------------------------------------------------------
PASSWORD_RESET_EXPIRES_MINUTES=30
RESET_REQUESTS_PER_HOUR=10

# --- Transactional email -----------------------------------------------------
EMAIL_PROVIDER=console
EMAIL_FROM=onboarding@resend.dev
RESEND_API_KEY=
SENDGRID_API_KEY=

# --- Supabase / PostgreSQL (SQLModel) ----------------------------------------
# DATABASE_URL=postgresql://postgres.[PROJECT_REF]:[YOUR_PASSWORD]@aws-1-us-west-2.pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL=

# --- Telemetry (Wave 1) ------------------------------------------------------
# Explicit overrides always win. In APP_ENV=development with DATABASE_URL set,
# backend telemetry auto-enables (TELEMETRY_ENABLED=true, TELEMETRY_SINK=both).
TELEMETRY_ENABLED=false
# stdout | postgres | both (postgres requires DATABASE_URL)
TELEMETRY_SINK=stdout
TELEMETRY_SAMPLE_RATE=1.0
# stub | storage (Phase 3 backend-storage default)
TELEMETRY_PHASE_MODE=storage
# Telemetry ingestion endpoint path (stub in Phase 2).
TELEMETRY_ENDPOINT=/telemetry/events

# --- Backoffice/website UI ---------------------------------------------------
# Backoffice dev: http://localhost:3000  |  Public website: uis/website (often port 3001)
# FRONTEND_BASE_URL is the backoffice origin used in auth email links.
NEXT_PUBLIC_TRACKER_API_BASE_URL=https://playground.4geeks.com/tracker/api/v1
BACKOFFICE_API_PROXY_TARGET=http://127.0.0.1:8000
# Legacy alias; next.config.mjs falls back to this when BACKOFFICE_API_PROXY_TARGET is unset.
INCIDENTS_API_PROXY_TARGET=http://127.0.0.1:8000
# Optional direct FastAPI origins (no trailing slash). Leave blank to use same-origin /api/* proxy.
NEXT_PUBLIC_INCIDENTS_API_BASE_URL=
NEXT_PUBLIC_SUPPLIERS_API_BASE_URL=
NEXT_PUBLIC_INVENTORY_API_BASE_URL=
NEXT_PUBLIC_REPORTING_API_BASE_URL=
NEXT_PUBLIC_KNOWLEDGE_API_BASE_URL=
NEXT_PUBLIC_TASKS_API_BASE_URL=
# Same-origin proxy default; override with a full URL for direct FastAPI calls.
NEXT_PUBLIC_TELEMETRY_ENDPOINT=/api/telemetry/events
NEXT_PUBLIC_TELEMETRY_API_BASE_URL=

# --- Redis / Celery (DEV-55) -------------------------------------------------
# Broker + Celery result backend. API enqueues; celery-worker consumes.
# Local (Redis via Compose published on 6379):
REDIS_URL=redis://127.0.0.1:6379/0
# Docker Compose services should use: redis://redis:6379/0

# --- Docker service-to-service URLs ------------------------------------------
# Used by docker-compose service env overrides so containers call by service name.
BACKOFFICE_API_PROXY_TARGET_DOCKER=http://backend:8000
INCIDENTS_API_PROXY_TARGET_DOCKER=http://backend:8000

# --- Qdrant / RAG (Milestone 7 / context-21) ---------------------------------
QDRANT_URL=http://127.0.0.1:6333
# Docker Compose backend override: http://qdrant:6333
QDRANT_COLLECTION=brasaland_knowledge
RAG_TOP_K=5
RAG_MIN_SCORE=0.30
# Optional corpus override (L9). Docker default path if unset: /app/docs/company-knowledge-base
# BRASALAND_KNOWLEDGE_BASE_DIR=/app/docs/company-knowledge-base

# Embeddings (dedicated model — never reuse the generation model)
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL_ID=

# Generation LLM (chat/completion — never reuse the embeddings model)
GENERATION_BASE_URL=
GENERATION_API_KEY=
GENERATION_MODEL_ID=

# --- Support Agent graph (context-23 Part 1) -------------------------------
# SQLite LangGraph checkpointer (runtime state — gitignored under data/agent/)
AGENT_CHECKPOINT_DB_PATH=data/agent/checkpoints.db
# Optional LangSmith tracing (off by default)
# LANGSMITH_TRACING=false
# LANGSMITH_API_KEY=
# Backoffice: leave blank for same-origin /api/agent/* proxy; set for direct FastAPI
NEXT_PUBLIC_AGENT_API_BASE_URL=

# --- Agent tools (context-23 Part 2) -----------------------------------------
AGENT_TOOL_TIMEOUT_SECONDS=5
# Base URL for in-process tool HTTP (default: http://127.0.0.1:8000)
AGENT_INTERNAL_API_BASE_URL=http://127.0.0.1:8000
