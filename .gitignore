.vercel
node_modules/
.env
**/.env
.env.local
**/.env.local
!.env.example
!**/.env.example

# Python virtual environment and caches
.venv/
**/.venv/
__pycache__/
**/__pycache__/
*.pyc

# Jupyter notebook checkpoints
.ipynb_checkpoints/
**/.ipynb_checkpoints/

# Next.js build output
.next/
**/.next/

# Generated script output (analyze.py export) — never commit
results.csv
**/results.csv

# Pipeline run artifacts (regenerated by CLI)
data/eval/*.json
!data/eval/test-queries.json
data/raw/*.json
data/raw/*.csv
!data/raw/brasaland_sales.csv
!data/eval/.gitkeep
!data/raw/.gitkeep

# Support Agent LangGraph checkpoint DB (runtime — context-23 P1; never commit)
data/agent/*
!data/agent/.gitkeep

# Local API TinyDB stores (users, auth, suppliers — PII / session data)
services/api/data/*.json
services/api/data/*.bak*
!services/api/data/.gitkeep

# Test coverage artifacts
coverage/
**/coverage/
.coverage
**/.coverage
.pytest_cache/
**/.pytest_cache/
